+// Match the libc++ std::uniform_int_distribution path used by macOS wheels
+// for the small non-negative ranges used by column sampling. This avoids
+// relying on libstdc++'s different std::shuffle/distribution implementation.
+template <typename Rng>
+std::uint64_t MacLibcxxUniformIndex(Rng* rng, std::uint64_t upper) {
+  auto const range = upper + 1;
+  if (range == 1) {
+    return 0;
+  }
+
+  unsigned width = 0;
+  for (std::uint64_t value = range - 1; value != 0; value >>= 1) {
+    ++width;
+  }
+  std::uint64_t const mask =
+      width == 64 ? ~std::uint64_t{0} : ((std::uint64_t{1} << width) - 1);
+
+  std::uint64_t out;
+  do {
+    out = static_cast<std::uint64_t>((*rng)() - Rng::min()) & mask;
+  } while (out >= range);
+  return out;
+}
+
+template <typename Iter, typename Rng>
+void MacLibcxxShuffle(Iter first, Iter last, Rng* rng) {
+  using Diff = typename std::iterator_traits<Iter>::difference_type;
+  Diff dist = last - first;
+  if (dist <= 1) {
+    return;
+  }
+  for (--last, static_cast<void>(--dist); first < last; ++first, static_cast<void>(--dist)) {
+    auto const swap_index =
+        static_cast<Diff>(MacLibcxxUniformIndex(rng, static_cast<std::uint64_t>(dist)));
+    if (swap_index != 0) {
+      std::iter_swap(first, first + swap_index);
+    }
+  }
+}
